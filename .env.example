# ==============================================================================
# AI PlacementOS - Global Environment Configuration
# ==============================================================================

# Application Environment (development, production, testing)
ENVIRONMENT=development

# Database Settings (PostgreSQL with pgvector)
POSTGRES_USER=placement_user
POSTGRES_PASSWORD=placement_secure_pass_2026
POSTGRES_DB=placement_os_db
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://placement_user:placement_secure_pass_2026@localhost:5432/placement_os_db

# Redis Distributed Cache
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# Ports & Hosts
API_PORT=8000
WEB_PORT=3000
FRONTEND_URL=http://localhost:3000

# Security & Authentication
JWT_SECRET=super_secret_jwt_key_placement_os_2026_at_least_32_bytes_long!
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# LLM Providers (Optional - platform functions with deterministic zero-mock defaults)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
